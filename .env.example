# Copia este archivo como .env y completa los valores.

# Conexión usada por la aplicación en runtime (en Supabase: pooler modo transacción, puerto 6543)
DATABASE_URL="postgresql://usuario:contrasena@host:6543/postgres?pgbouncer=true"

# Conexión directa/sesión usada por el CLI de Prisma para migraciones y seed (puerto 5432)
DIRECT_URL="postgresql://usuario:contrasena@host:5432/postgres"

# Supabase Auth (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Secret key (sb_secret_…): solo servidor, NUNCA con prefijo NEXT_PUBLIC_. La usa el módulo
# Sistema → Usuarios para crear cuentas del equipo en Supabase Auth.
SUPABASE_SECRET_KEY="sb_secret_..."

# OpenAI · captura inteligente (secreta, solo servidor)
OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o"

# Almacenamiento de archivos de pólizas (carátulas, formatos de negociación, expedientes ZIP)
# "supabase" (por omisión) o "r2". La base de datos solo guarda la clave del objeto, así que
# cambiar de proveedor no requiere migrar datos. Configuración de R2: docs/almacenamiento-r2.md
# ALMACEN_ARCHIVOS="r2"
# R2_ACCOUNT_ID="..."          # Cloudflare → R2 → Account ID
# R2_ACCESS_KEY_ID="..."       # token de API de R2 (secreto, solo servidor)
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET_NAME="pjmagnus-polizas" # bucket PRIVADO

# Resend · correos a clientes desde Comunicaciones (secreta, solo servidor)
# El dominio del remitente debe estar verificado en Resend (registros DNS SPF/DKIM).
RESEND_API_KEY="re_..."
# Dirección universal de la plataforma: todas las agencias envían desde ella. El nombre visible
# se ignora: cada correo sale con el nombre, logo y color de la agencia que lo envía.
EMAIL_SENDER="Magnus Seguros <servicio@magnusseguros.com>"
# Tarea diaria: una tarea programada llama a GET /api/cron/avisos con el encabezado
# "Authorization: Bearer <CRON_SECRET>". Envía los avisos automáticos a clientes (Configuración →
# Avisos automáticos) y corre la cobranza de la plataforma (avisos de pago y suspensión automática).
# Cada ejecución queda registrada: Plataforma → Diagnóstico avisa si falla o deja de correr.
# Valor largo y aleatorio (p. ej. `openssl rand -hex 32`); secreto, solo servidor.
CRON_SECRET="..."
# Opcional: a dónde llegan las respuestas de los clientes (un buzón que sí se revise)
# EMAIL_REPLY_TO="contacto@magnusseguros.com"

# Opcional: nombre de la plataforma en el inicio de sesión sin marca y en los correos de cobro a
# las agencias. Sin él se toma el nombre visible de EMAIL_SENDER ("Magnus Seguros"), y si no lo
# tiene, "Atelier Zenith". El monograma está en public/marca/plataforma.png (y los íconos de la
# pestaña en app/favicon.ico, app/icon.png y app/apple-icon.png).
# PLATAFORMA_NOMBRE="Atelier Zenith"
