# Copia este archivo como .env y completa los valores.

# Conexión usada por la aplicación en runtime (en Supabase: pooler modo transacción, puerto 6543)
DATABASE_URL="postgresql://usuario:contrasena@host:6543/postgres?pgbouncer=true"

# Conexión directa/sesión usada por el CLI de Prisma para migraciones y seed (puerto 5432)
DIRECT_URL="postgresql://usuario:contrasena@host:5432/postgres"

# Supabase Auth (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
