// Esquema de datos del CRM PJ MAGNUS.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Ramo {
  AUTOS
  GASTOS_MEDICOS
  VIDA
  EMPRESARIAL
}

enum FormaPago {
  ANUAL
  SEMESTRAL
  TRIMESTRAL
  MENSUAL
}

enum EstadoRecibo {
  PENDIENTE
  PAGADO
  CONCILIADO
}

model Cliente {
  id       String @id @default(cuid())
  nombre   String
  rfc      String
  telefono String
  email    String

  polizas Poliza[]

  @@index([rfc])
  @@map("clientes")
}

model Aseguradora {
  id                  String  @id @default(cuid())
  nombre              String  @unique
  color_hex           String
  url_portal_cobranza String?
  notas_acceso        String?

  // Integración con API oficial (Fase 4).
  // IMPORTANTE: api_key y api_secret deben guardarse cifrados en la aplicación
  // antes de escribirse aquí; nunca en texto plano.
  api_key      String?
  api_secret   String?
  api_endpoint String?
  estado_api   String  @default("INACTIVA")

  polizas Poliza[]

  @@map("aseguradoras")
}

model Poliza {
  id                     String    @id @default(cuid())
  // Número tal como aparece en la carátula (lo captura el OCR).
  numero_poliza_original String    @unique
  // Número vigente cuando la aseguradora lo reasigna en sus sistemas (SAP, MetLife, etc.).
  numero_poliza_vigor    String?   @unique
  ramo                   Ramo
  cliente_id             String
  aseguradora_id         String
  vigencia_inicio        DateTime  @db.Date
  vigencia_fin           DateTime  @db.Date
  // Prima de toda la vigencia capturada; se reparte entre los recibos.
  prima_total            Decimal   @db.Decimal(14, 2)
  forma_pago             FormaPago
  // Campos específicos del ramo (vehículo, suma asegurada, beneficiario, etc.).
  datos_ramo             Json      @default("{}")
  created_at             DateTime  @default(now())

  cliente     Cliente     @relation(fields: [cliente_id], references: [id])
  aseguradora Aseguradora @relation(fields: [aseguradora_id], references: [id])
  recibos     Recibo[]

  @@index([cliente_id])
  @@index([aseguradora_id])
  @@index([created_at])
  @@map("polizas")
}

model Recibo {
  id                String       @id @default(cuid())
  poliza_id         String
  // Consecutivo del recibo dentro de la póliza (1..n).
  numero            Int
  monto             Decimal      @db.Decimal(14, 2)
  fecha_vencimiento DateTime     @db.Date
  estado            EstadoRecibo @default(PENDIENTE)

  poliza Poliza @relation(fields: [poliza_id], references: [id])

  @@unique([poliza_id, numero])
  @@index([estado, fecha_vencimiento])
  @@map("recibos")
}
