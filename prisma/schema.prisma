// Esquema de datos del CRM (SaaS multi-agencia).
// Cada registro de negocio pertenece a una Agencia (agenciaId). Los datos existentes de antes
// del multi-tenant quedaron en la agencia inicial "PJ MAGNUS" (migración 20260929100000).
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Ramo {
  AUTOS
  GMM_INDIVIDUAL
  GMM_COLECTIVO
  VIDA_INDIVIDUAL
  VIDA_GRUPO
  DANOS
  RC_PROFESIONAL
  HOGAR
  OTROS
}

enum FormaPago {
  ANUAL
  SEMESTRAL
  TRIMESTRAL
  MENSUAL
}

// CANCELADO: recibo pendiente de una póliza cancelada; ya no se cobra (al reactivar la póliza
// vuelve a PENDIENTE).
enum EstadoRecibo {
  PENDIENTE
  PAGADO
  CONCILIADO
  CANCELADO
}

enum TipoPersona {
  FISICA
  MORAL
}

// Seguimiento de la renovación de una póliza (Renovaciones). Sin etapa = por renovar; la
// renovada no se guarda: es la que ya tiene capturada su renovación.
enum EtapaRenovacion {
  COTIZANDO
  ENVIADA
  PERDIDA
}

// ADMIN (Administrador): acceso total. EJECUTIVO (Ejecutivo comercial): operación diaria con
// conciliación de cobranza, sin comisiones ni configuración. OPERACION (Ejecutiva de operación),
// LIDER_OFICINA (Líder de oficina) y AUXILIAR solo usan Tareas (ver lib/usuarios/reglas.ts).
enum Rol {
  ADMIN
  EJECUTIVO
  OPERACION
  LIDER_OFICINA
  AUXILIAR
}

// Broker o agencia cliente del SaaS: dueña de todos sus datos (tenant).
// El agenciaId de cada tabla no tiene default: el código lo toma de la sesión
// (UsuarioSesion.agenciaId) en cada consulta y escritura.
model Agencia {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String
  // Ícono o monograma cuadrado de la barra lateral.
  logoUrl   String?  @map("logo_url")
  // Logotipo completo para documentos y correos; sin él, los correos usan el ícono.
  logoDocumentosUrl String? @map("logo_documentos_url")
  colorHex  String?  @map("color_hex")
  // Fondo de la interfaz: "dark" o "light" (lo valida un CHECK en la base de datos).
  tema      String   @default("dark")
  // Buzón de la agencia (p. ej. servicios@…) que recibe copia de cada aviso automático y las
  // respuestas de los clientes (Configuración → Avisos automáticos).
  correoCopiaAvisos String? @map("correo_copia_avisos")
  // Correo de atención a clientes (p. ej. servicio@…): va en los correos masivos y en el de
  // agradecimiento por renovar, y es a donde responden (Configuración → Mi agencia).
  correoServicio    String? @map("correo_servicio")
  // Suspensión por falta de pago (la decide el SUPERADMIN): sus usuarios no pueden entrar y no
  // salen sus avisos automáticos. No borra nada; al reactivarla todo sigue como estaba.
  suspendida        Boolean   @default(false)
  suspendidaAt      DateTime? @map("suspendida_at")
  motivoSuspension  String?   @map("motivo_suspension")
  // Liga de acceso con la marca de la agencia: /login?agencia=<slug>.
  slug              String    @unique
  // true: cada EJECUTIVO solo ve los clientes y pólizas que tiene asignados.
  carteraPorEjecutivo Boolean @default(false) @map("cartera_por_ejecutivo")
  // Cobranza de la plataforma (la configura el SUPERADMIN). Cuota mensual y fecha hasta la que
  // está pagado el servicio; sin ambas no se cobra ni se suspende nada.
  cuotaMensual          Decimal?  @db.Decimal(12, 2) @map("cuota_mensual")
  pagadoHasta           DateTime? @db.Date @map("pagado_hasta")
  // Días después de pagadoHasta en que aún se puede pagar sin suspensión.
  diasToleranciaPago    Int       @default(5) @map("dias_tolerancia_pago")
  // Pasada la tolerancia, la tarea diaria suspende la agencia.
  suspensionAutomatica  Boolean   @default(false) @map("suspension_automatica")
  // pagadoHasta del último aviso de cobro enviado: evita repetirlo en el mismo periodo.
  avisoCobroEnviadoPara DateTime? @db.Date @map("aviso_cobro_enviado_para")
  // A quién se mandan los avisos de cobro; sin él, a los administradores de la agencia.
  correoFacturacion     String?   @map("correo_facturacion")
  // Plan de suscripción (lo asigna el SUPERADMIN): fija sus límites de usuarios activos y de
  // escaneos con IA al mes (lib/planes). El estado de la suscripción es el de la cobranza de
  // arriba: pagadoHasta, la tolerancia y `suspendida`.
  plan                  PlanAgencia      @default(AGENTE)
  // Básico o Pro: cada una con sus límites (lib/planes).
  edicion               EdicionPlan      @default(PRO) @map("edicion_plan")
  cicloFacturacion      CicloFacturacion @default(MENSUAL) @map("ciclo_facturacion")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuarios           Usuario[]          @relation("UsuariosAgencia")
  // Superadmins que están operando esta agencia en este momento.
  superadminsActivos Usuario[]          @relation("AgenciaActiva")
  clientes           Cliente[]
  aseguradoras       Aseguradora[]
  polizas            Poliza[]
  recibos            Recibo[]
  asegurados         Asegurado[]
  esquemasComision   EsquemaComision[]
  bitacora           Bitacora[]
  lotesConciliacion  LoteConciliacion[]
  lotesCambios       LoteCambio[]
  lotesRenglones     LoteRenglon[]
  notasAclaracion    NotaAclaracion[]
  avisosEnviados     AvisoEnviado[]
  endosos            Endoso[]
  notasCliente       NotaCliente[]
  tareas             Tarea[]
  responsablesTareas TareaResponsable[]
  pagosPlataforma    PagoPlataforma[]
  conversaciones     Conversacion[]
  mensajes           Mensaje[]
  lecturasMensajes   ConversacionLectura[]
  suscripcionesPush  SuscripcionPush[]
  usoOcr             UsoOcr[]

  @@map("agencias")
}

// Planes de ZenSecure. Sus límites y precios están en lib/planes/planes.ts.
enum PlanAgencia {
  AGENTE
  BROKER
}

enum EdicionPlan {
  BASICO
  PRO
}

enum CicloFacturacion {
  MENSUAL
  ANUAL
}

// Escaneos de carátulas con IA (POST /api/ocr) de cada agencia por mes, contra el límite de su
// plan. Se reserva el escaneo antes de llamar a la IA y se devuelve si la lectura falla.
model UsoOcr {
  agenciaId String  @map("agencia_id") @db.Uuid
  agencia   Agencia @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  // Primer día del mes, en hora de la Ciudad de México.
  periodo   DateTime @db.Date
  escaneos  Int      @default(0)

  @@id([agenciaId, periodo])
  @@map("uso_ocr")
}

// Rol en la plataforma (por encima de las agencias). SUPERADMIN puede entrar a cualquier
// agencia (Usuario.agenciaActivaId); solo se asigna con prisma/asignar-superadmin.ts.
enum RolSistema {
  USER
  SUPERADMIN
}

// Perfil y rol de cada cuenta del equipo. La autenticación (correo y contraseña, guardada con
// bcrypt) la hace Supabase Auth; aquí solo vive lo que el CRM necesita saber de la persona.
model Usuario {
  // Mismo id que auth.users en Supabase.
  id              String     @id
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId       String     @map("agencia_id") @db.Uuid
  agencia         Agencia    @relation("UsuariosAgencia", fields: [agenciaId], references: [id], onDelete: Restrict)
  nombre          String
  email           String     @unique
  rol             Rol        @default(EJECUTIVO)
  rolSistema      RolSistema @default(USER) @map("rol_sistema")
  // Solo SUPERADMIN: agencia que está operando (null = la propia, agenciaId). La sesión usa esta
  // y la escribe en el JWT; agenciaId sigue siendo la agencia a la que pertenece la cuenta.
  agenciaActivaId String?    @map("agencia_activa_id") @db.Uuid
  agenciaActiva   Agencia?   @relation("AgenciaActiva", fields: [agenciaActivaId], references: [id], onDelete: SetNull)
  // Borrado suave: una cuenta desactivada no puede entrar (además se bloquea en Supabase
  // Auth), pero se conserva para el historial y puede reactivarse.
  activo          Boolean    @default(true)
  desactivado_at  DateTime?
  created_at      DateTime   @default(now())

  clientesAsignados Cliente[]          @relation("EjecutivoCliente")
  polizasAsignadas  Poliza[]           @relation("EjecutivoPoliza")
  tareasAsignadas   TareaResponsable[]
  conversacionesA   Conversacion[]        @relation("ConversacionUsuarioA")
  conversacionesB   Conversacion[]        @relation("ConversacionUsuarioB")
  mensajes          Mensaje[]
  lecturasMensajes  ConversacionLectura[]
  suscripcionesPush SuscripcionPush[]

  @@index([agenciaId])
  @@map("usuarios")
}

model Cliente {
  id        String  @id @default(cuid())
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId String  @map("agencia_id") @db.Uuid
  agencia   Agencia @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  nombre    String
  rfc       String
  telefono  String
  email     String
  // Física (RFC de 13) o moral (RFC de 12); se deduce del RFC al crearlo y se puede corregir.
  tipoPersona     TipoPersona @default(FISICA) @map("tipo_persona")
  // Solo persona física; si falta se usa la del RFC.
  fechaNacimiento DateTime?   @db.Date @map("fecha_nacimiento")
  // Calle, número y colonia.
  direccion       String?
  municipio       String?
  // Entidad federativa.
  estado          String?
  codigoPostal    String?     @map("codigo_postal")
  // Ejecutivo responsable del cliente (cartera).
  ejecutivoId     String?     @map("ejecutivo_id")
  ejecutivo       Usuario?    @relation("EjecutivoCliente", fields: [ejecutivoId], references: [id], onDelete: SetNull)

  polizas Poliza[]
  notas   NotaCliente[]
  tareas  Tarea[]

  @@index([rfc])
  @@index([agenciaId])
  @@index([ejecutivoId])
  @@map("clientes")
}

model Aseguradora {
  id                  String  @id @default(cuid())
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId           String  @map("agencia_id") @db.Uuid
  agencia             Agencia @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  nombre              String
  color_hex           String
  url_portal_cobranza String?
  notas_acceso        String?

  // Integración con API oficial (Fase 4).
  // IMPORTANTE: api_key y api_secret deben guardarse cifrados en la aplicación
  // antes de escribirse aquí; nunca en texto plano.
  api_key      String?
  api_secret   String?
  api_endpoint String?
  estado_api   String  @default("INACTIVA")

  // Reglas de cobranza de la aseguradora (Aseguradoras → Reglas de cobranza).
  // false (p. ej. Quálitas): su cobranza usa el número de póliza completo, no una póliza vigor.
  // La captura no pide el campo y la conciliación cruza solo por número impreso.
  usaPolizaVigor          Boolean @default(true) @map("usa_poliza_vigor")
  // true (p. ej. Quálitas): el estado de cuenta repite renglones; del mismo recibo de la misma
  // póliza (p. ej. "1/12") solo cuenta el primero.
  ignoraRecibosDuplicados Boolean @default(false) @map("ignora_recibos_duplicados")
  // Días después del vencimiento de un recibo en que aún se puede pagar sin que se cancele la
  // póliza (p. ej. MetLife 30, Quálitas 0). Pasado ese plazo el recibo está en riesgo.
  diasGracia              Int     @default(0) @map("dias_gracia")

  // Matriz de avisos automáticos por correo (Configuración → Avisos automáticos). null = ese
  // aviso no se envía para esta aseguradora.
  // Días antes del vencimiento de un recibo en que se recuerda el pago.
  avisoDiasAntes      Int? @map("aviso_dias_antes")
  // Días después del vencimiento en que se avisa que el recibo sigue sin pagar.
  avisoDiasVencido    Int? @map("aviso_dias_vencido")
  // Días antes del fin de vigencia en que se avisa de la renovación.
  avisoDiasRenovacion Int? @map("aviso_dias_renovacion")

  polizas  Poliza[]
  esquemas EsquemaComision[]
  lotes    LoteConciliacion[]

  @@unique([agenciaId, nombre])
  @@map("aseguradoras")
}

model Poliza {
  id                         String    @id @default(cuid())
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId                  String    @map("agencia_id") @db.Uuid
  agencia                    Agencia   @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  // Lectura cruda del número tal como aparece en la carátula (lo captura el OCR).
  numeroImpreso              String    @map("numero_poliza_original")
  // Póliza vigor: clave de cobranza de esta vigencia (se propone con extraerPolizaVigor(),
  // lib/polizas/polizaParser.ts). Cambia en cada renovación; el número original se conserva.
  // En aseguradoras sin póliza vigor (usaPolizaVigor = false) no se muestra ni se usa para
  // cobrar: vale el número impreso.
  polizaVigor                String?   @map("numero_poliza_vigor")
  // Cadena de renovaciones: el id de la primera póliza (la original vale su propio id). Liga
  // cada renovación con las anteriores aunque cambie la póliza vigor; de ella salen la
  // renovación siguiente, la anterior y el año de la póliza para la comisión.
  cadenaId                   String    @map("cadena_id")
  ramo                       Ramo
  cliente_id                 String
  aseguradora_id             String
  vigencia_inicio            DateTime  @db.Date
  vigencia_fin               DateTime  @db.Date
  // Prima de toda la vigencia capturada; se reparte entre los recibos.
  prima_total                Decimal   @db.Decimal(14, 2)
  // Prima neta de la vigencia (sin IVA, recargos ni derecho de póliza): la base de la comisión.
  // Opcional solo por las pólizas capturadas antes de existir el campo.
  prima_neta                 Decimal?  @db.Decimal(14, 2)
  forma_pago                 FormaPago
  // Campos específicos del ramo (vehículo, suma asegurada, beneficiario, etc.). La suma
  // asegurada es opcional ahí: si es ilimitada, la cantidad y su unidad no se guardan.
  datos_ramo                 Json      @default("{}")
  // La carátula dice "Sin límite", "Ilimitada", "S/L", "Amparada"… en la suma asegurada.
  sumaAseguradaIlimitada     Boolean   @default(false) @map("suma_asegurada_ilimitada")
  // Porcentaje de comisión negociado para esta póliza (p. ej. colectivos de MetLife cuya
  // comisión depende de la edad de los integrantes). Si existe, reemplaza al EsquemaComision.
  comision_personalizada_pct Decimal?  @db.Decimal(5, 2)
  created_at                 DateTime  @default(now())

  // Ejecutivo responsable de la póliza (cartera y producción por ejecutivo).
  ejecutivoId       String?          @map("ejecutivo_id")
  ejecutivo         Usuario?         @relation("EjecutivoPoliza", fields: [ejecutivoId], references: [id], onDelete: SetNull)
  // Cancelación: la póliza se conserva con su historia y sus recibos pendientes pasan a
  // CANCELADO. canceladaAt es la fecha efectiva de la cancelación.
  canceladaAt       DateTime?        @db.Date @map("cancelada_at")
  motivoCancelacion String?          @map("motivo_cancelacion")
  // Seguimiento de la renovación (Renovaciones): etapa, motivo de pérdida o nota, y cuándo cambió.
  renovacionEtapa   EtapaRenovacion? @map("renovacion_etapa")
  renovacionNota    String?          @map("renovacion_nota")
  renovacionEtapaAt DateTime?        @map("renovacion_etapa_at")

  // Archivos de la póliza en Supabase Storage, bucket "expedientes".
  // Solo se guarda la referencia (ruta dentro del bucket); el archivo vive en Storage.
  // Carátula en PDF: para consultarla rápido sin descargar el expediente.
  caratula_path         String?
  caratula_nombre       String?
  caratula_bytes        Int?
  caratula_subido_at    DateTime?
  // Formato de negociación u orden de emisión (PDF) de GMM Colectivo.
  negociacion_path      String?
  negociacion_nombre    String?
  negociacion_bytes     Int?
  negociacion_subido_at DateTime?
  // Expediente completo (ZIP) de respaldo.
  expediente_path       String?
  expediente_nombre     String?
  expediente_bytes      Int?
  expediente_subido_at  DateTime?

  cliente     Cliente     @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  // Restrict: borrar una aseguradora no debe arrastrar la cartera de pólizas.
  aseguradora Aseguradora @relation(fields: [aseguradora_id], references: [id], onDelete: Restrict)
  recibos     Recibo[]
  asegurados  Asegurado[]
  // Renglones de estados de cuenta que la conciliación asoció a esta póliza sin poder conciliarlos.
  renglonesConciliacion LoteRenglon[]
  endosos     Endoso[]
  notas       NotaCliente[]
  tareas      Tarea[]

  // Las renovaciones comparten el número original; dos pólizas con el mismo número y la misma
  // vigencia son una captura repetida.
  @@unique([agenciaId, numeroImpreso, vigencia_inicio])
  @@index([polizaVigor])
  @@index([cadenaId])
  @@index([cliente_id])
  @@index([aseguradora_id])
  @@index([vigencia_fin])
  @@index([created_at])
  @@index([ejecutivoId])
  @@map("polizas")
}

// Endoso de una póliza: cambio durante la vigencia (suma asegurada, altas o bajas de asegurados,
// datos) con su movimiento de prima: positiva = cobro adicional, negativa = devolución.
model Endoso {
  id           String   @id @default(cuid())
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId    String   @map("agencia_id") @db.Uuid
  agencia      Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  polizaId     String   @map("poliza_id")
  poliza       Poliza   @relation(fields: [polizaId], references: [id], onDelete: Cascade)
  // Número de endoso de la aseguradora, si lo tiene.
  numero       String?
  // Clave de lib/polizas/endosos.ts (aumento_suma, alta_asegurado, …).
  tipo         String
  // Fecha en que surte efecto.
  fecha        DateTime @db.Date
  descripcion  String
  prima        Decimal? @db.Decimal(14, 2)
  usuarioEmail String?  @map("usuario_email")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([polizaId, fecha])
  @@index([agenciaId])
  @@map("endosos")
}

// Seguimiento de un cliente: notas, llamadas, mensajes y reuniones, opcionalmente sobre una póliza.
model NotaCliente {
  id           String   @id @default(cuid())
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId    String   @map("agencia_id") @db.Uuid
  agencia      Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  clienteId    String   @map("cliente_id")
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  polizaId     String?  @map("poliza_id")
  poliza       Poliza?  @relation(fields: [polizaId], references: [id], onDelete: SetNull)
  // Clave de lib/clientes/seguimiento.ts (nota, llamada, whatsapp, correo, reunion).
  tipo         String
  texto        String
  usuarioId    String?  @map("usuario_id")
  usuarioEmail String?  @map("usuario_email")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([clienteId, createdAt])
  @@index([agenciaId])
  @@map("notas_cliente")
}

// Pendiente con fecha y responsable, opcionalmente de un cliente o una póliza.
model Tarea {
  id                 String    @id @default(cuid())
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId          String    @map("agencia_id") @db.Uuid
  agencia            Agencia   @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  titulo             String
  descripcion        String?
  vence              DateTime  @db.Date
  // Encargados: cada uno marca su parte; sin encargados, la marca cualquiera.
  responsables       TareaResponsable[]
  clienteId          String?   @map("cliente_id")
  cliente            Cliente?  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  polizaId           String?   @map("poliza_id")
  poliza             Poliza?   @relation(fields: [polizaId], references: [id], onDelete: SetNull)
  creadaPorEmail     String?   @map("creada_por_email")
  completadaAt       DateTime? @map("completada_at")
  completadaPorEmail String?   @map("completada_por_email")
  // Borrado suave: "Deshacer" la recupera tal cual, con sus encargados y su avance.
  eliminadaAt        DateTime? @map("eliminada_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([agenciaId, completadaAt, vence])
  @@index([clienteId])
  @@index([polizaId])
  @@map("tareas")
}

// Encargado de una tarea y su parte: la tarea queda hecha (Tarea.completadaAt) cuando todos
// terminan; el avance es cuántos ya terminaron.
model TareaResponsable {
  tareaId      String    @map("tarea_id")
  tarea        Tarea     @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  usuarioId    String    @map("usuario_id")
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId    String    @map("agencia_id") @db.Uuid
  agencia      Agencia   @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  completadaAt DateTime? @map("completada_at")

  @@id([tareaId, usuarioId])
  @@index([usuarioId, completadaAt])
  @@index([agenciaId])
  @@map("tareas_responsables")
}

// Mensajería interna del equipo de una agencia: el canal de todos ("equipo", uno por agencia) y
// las conversaciones directas entre dos personas ("dm:<idA>:<idB>", ids ordenados: una por pareja).
model Conversacion {
  id              String                @id @default(cuid())
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId       String                @map("agencia_id") @db.Uuid
  agencia         Agencia               @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  clave           String
  // Solo en las directas: sus dos participantes.
  usuarioAId      String?               @map("usuario_a_id")
  usuarioA        Usuario?              @relation("ConversacionUsuarioA", fields: [usuarioAId], references: [id], onDelete: Cascade)
  usuarioBId      String?               @map("usuario_b_id")
  usuarioB        Usuario?              @relation("ConversacionUsuarioB", fields: [usuarioBId], references: [id], onDelete: Cascade)
  ultimoMensajeAt DateTime?             @map("ultimo_mensaje_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  mensajes        Mensaje[]
  lecturas        ConversacionLectura[]

  @@unique([agenciaId, clave])
  @@index([usuarioAId])
  @@index([usuarioBId])
  @@map("conversaciones")
}

model Mensaje {
  id             String       @id @default(cuid())
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId      String       @map("agencia_id") @db.Uuid
  agencia        Agencia      @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  conversacionId String       @map("conversacion_id")
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  autorId        String?      @map("autor_id")
  autor          Usuario?     @relation(fields: [autorId], references: [id], onDelete: SetNull)
  texto          String
  // Archivo o imagen adjunto (uno por mensaje): clave del objeto en el almacenamiento
  // (chat/{agenciaId}/{uuid}.{ext}), nombre original, tipo, tamaño y, si es imagen, sus medidas.
  adjuntoClave   String?      @unique @map("adjunto_clave")
  adjuntoNombre  String?      @map("adjunto_nombre")
  adjuntoTipo    String?      @map("adjunto_tipo")
  adjuntoBytes   Int?         @map("adjunto_bytes")
  adjuntoAncho   Int?         @map("adjunto_ancho")
  adjuntoAlto    Int?         @map("adjunto_alto")
  createdAt      DateTime     @default(now()) @map("created_at")
  // Borrado suave: queda "Mensaje eliminado" en su lugar.
  eliminadoAt    DateTime?    @map("eliminado_at")

  @@index([conversacionId, createdAt])
  @@index([agenciaId])
  @@map("mensajes")
}

// Hasta dónde leyó cada persona una conversación: lo posterior (de otros) cuenta como no leído.
model ConversacionLectura {
  conversacionId String       @map("conversacion_id")
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  usuarioId      String       @map("usuario_id")
  usuario        Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId      String       @map("agencia_id") @db.Uuid
  agencia        Agencia      @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  leidoHasta     DateTime     @map("leido_hasta")

  @@id([conversacionId, usuarioId])
  @@index([usuarioId])
  @@index([agenciaId])
  @@map("conversaciones_lecturas")
}

// Notificaciones push del navegador: cada dispositivo (navegador) en el que la persona las activó.
// Le llegan avisos de mensajes y tareas aunque no tenga el CRM abierto.
model SuscripcionPush {
  id        String   @id @default(cuid())
  // Agencia dueña del registro (la propia de la cuenta).
  agenciaId String   @map("agencia_id") @db.Uuid
  agencia   Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  usuarioId String   @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // Dirección del servicio de push del navegador y sus llaves de cifrado.
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([usuarioId])
  @@index([agenciaId])
  @@map("suscripciones_push")
}

// Pagos de una agencia por el uso de la plataforma (los registra el SUPERADMIN).
model PagoPlataforma {
  id            String   @id @default(cuid())
  agenciaId     String   @map("agencia_id") @db.Uuid
  agencia       Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  fecha         DateTime @db.Date
  monto         Decimal  @db.Decimal(12, 2)
  // pagadoHasta de la agencia después de este pago.
  cubreHasta    DateTime @db.Date @map("cubre_hasta")
  nota          String?
  registradoPor String?  @map("registrado_por")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([agenciaId, fecha])
  @@map("pagos_plataforma")
}

// Ejecuciones de las tareas programadas (GET /api/cron/...): el panel del SUPERADMIN avisa si
// la última falló o si dejó de correr.
model EjecucionCron {
  id      String    @id @default(cuid())
  // "diaria"
  tarea   String
  inicio  DateTime  @default(now())
  fin     DateTime?
  ok      Boolean?
  resumen Json?
  error   String?

  @@index([tarea, inicio])
  @@map("ejecuciones_cron")
}

model Recibo {
  id                String       @id @default(cuid())
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId         String       @map("agencia_id") @db.Uuid
  agencia           Agencia      @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  poliza_id         String
  // Consecutivo del recibo dentro de la póliza (1..n).
  numero            Int
  monto             Decimal      @db.Decimal(14, 2)
  fecha_vencimiento DateTime     @db.Date
  estado            EstadoRecibo @default(PENDIENTE)
  // Rastro de la conciliación: comisión que reportó la aseguradora y cuándo se concilió.
  comision_pagada   Decimal?     @db.Decimal(14, 2)
  conciliado_at     DateTime?
  // Folio con el que la aseguradora identifica el recibo (p. ej. 27872103), tomado del estado
  // de cuenta. Evita conciliar o crear dos veces el mismo recibo al reprocesar un archivo.
  folio             String?
  // Lo creó la conciliación porque el estado de cuenta lo reporta cobrado y no existía en el
  // CRM. Su monto es estimado (prima de la póliza entre sus recibos) si el archivo no lo trae.
  auto_creado       Boolean      @default(false)

  cambios_lote LoteCambio[]
  notas        NotaAclaracion[]

  poliza Poliza @relation(fields: [poliza_id], references: [id], onDelete: Cascade)

  @@unique([poliza_id, numero])
  @@unique([poliza_id, folio])
  @@index([fecha_vencimiento])
  @@index([estado, fecha_vencimiento])
  @@index([agenciaId])
  @@map("recibos")
}

// Personas aseguradas por la póliza (varias en GMM; en Autos o RC, solo el titular).
model Asegurado {
  id               String  @id @default(cuid())
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId        String  @map("agencia_id") @db.Uuid
  agencia          Agencia @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  poliza_id        String
  // Posición en la lista de la carátula.
  orden            Int     @default(0)
  nombre           String
  // Titular, Conyuge, Padre, Madre, Hijo u Otro (lib/polizas/asegurados.ts).
  parentesco       String
  edad             Int?
  // Masculino o Femenino.
  sexo             String?
  // YYYY-MM-DD.
  fecha_nacimiento String?
  // Antigüedad en la aseguradora, tal como aparece en la carátula.
  antiguedad       String?

  poliza Poliza @relation(fields: [poliza_id], references: [id], onDelete: Cascade)

  @@index([poliza_id])
  @@index([agenciaId])
  @@map("asegurados")
}

// Matriz de comisiones: porcentaje por aseguradora, ramo y año de la póliza (1 = negocio
// nuevo, 2 = primera renovación…). Si el año no está definido se usa el mayor año definido
// que no lo exceda, así un solo renglón de año 1 funciona como porcentaje fijo.
// El rango de edad (del titular, típico en GMM) es opcional: las reglas de un mismo rango
// forman su propia tabla por año y tienen prioridad sobre las que aplican a todas las edades.
// La unicidad (mismo año y rango) y que los rangos no se traslapen se validan en
// lib/comisiones/actions.ts, porque un índice único trataría los NULL como distintos.
model EsquemaComision {
  id             String  @id @default(cuid())
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId      String  @map("agencia_id") @db.Uuid
  agencia        Agencia @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  aseguradora_id String
  ramo           Ramo
  anio_poliza    Int
  porcentaje     Decimal @db.Decimal(5, 2)
  // Límites inclusivos; null = sin límite. Ambos null = todas las edades.
  edad_minima    Int?
  edad_maxima    Int?

  aseguradora Aseguradora @relation(fields: [aseguradora_id], references: [id], onDelete: Cascade)

  @@index([aseguradora_id, ramo, anio_poliza])
  @@index([agenciaId])
  @@map("esquemas_comision")
}

// Bitácora de auditoría: quién hizo qué y cuándo (conciliaciones, pólizas, matriz, usuarios).
// Guarda el correo además del id para seguir siendo legible si la cuenta se desactiva.
model Bitacora {
  id            String   @id @default(cuid())
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId     String   @map("agencia_id") @db.Uuid
  agencia       Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  created_at    DateTime @default(now())
  usuario_id    String?
  usuario_email String?
  // Clave estable de la acción, p. ej. "conciliacion.aplicar" o "poliza.editar".
  accion        String
  // Tipo de registro afectado ("poliza", "recibo", "lote", "regla_comision", "usuario").
  entidad       String
  entidad_id    String?
  descripcion   String
  // Detalle opcional: valores antes/después, conteos, etc.
  datos         Json?

  @@index([created_at])
  @@index([entidad, entidad_id])
  @@index([agenciaId])
  @@map("bitacora")
}

// Cada "Aplicar conciliación" es un lote: se puede revertir si se subió el archivo equivocado.
model LoteConciliacion {
  id             String    @id @default(cuid())
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId      String    @map("agencia_id") @db.Uuid
  agencia        Agencia   @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  created_at     DateTime  @default(now())
  aseguradora_id String
  usuario_id     String?
  usuario_email  String?
  archivo_nombre String
  renglones      Int
  conciliados    Int
  pagados        Int
  creados        Int
  revertido_at   DateTime?
  revertido_por  String?

  aseguradora Aseguradora  @relation(fields: [aseguradora_id], references: [id], onDelete: Cascade)
  cambios     LoteCambio[]
  sinConciliar LoteRenglon[]

  @@index([created_at])
  @@index([agenciaId])
  @@map("lotes_conciliacion")
}

// Qué le hizo un lote a cada recibo, con el estado anterior para poder revertirlo.
model LoteCambio {
  id            String  @id @default(cuid())
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId     String  @map("agencia_id") @db.Uuid
  agencia       Agencia @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  lote_id       String
  // Null si el recibo ya no existe (p. ej. se eliminó su póliza).
  recibo_id     String?
  // "conciliado" | "pagado" | "creado"
  tipo          String
  fila          Int
  poliza_numero String
  recibo_numero Int

  estado_anterior        EstadoRecibo?
  comision_anterior      Decimal?      @db.Decimal(14, 2)
  folio_anterior         String?
  conciliado_at_anterior DateTime?
  estado_nuevo           EstadoRecibo
  comision_nueva         Decimal       @db.Decimal(14, 2)

  lote   LoteConciliacion @relation(fields: [lote_id], references: [id], onDelete: Cascade)
  recibo Recibo?          @relation(fields: [recibo_id], references: [id], onDelete: SetNull)

  @@index([lote_id])
  @@index([recibo_id])
  @@index([agenciaId])
  @@map("lotes_cambios")
}

// Avisos automáticos ya enviados: evita mandar dos veces el mismo aviso del mismo recibo o póliza.
model AvisoEnviado {
  id            String   @id @default(cuid())
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId     String   @map("agencia_id") @db.Uuid
  agencia       Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  created_at    DateTime @default(now())
  // "por_vencer" | "vencido" | "renovacion" (lib/avisos/reglas.ts)
  tipo          String
  // Id del recibo (por_vencer, vencido) o de la póliza (renovacion).
  referencia_id String
  destinatario  String

  @@unique([tipo, referencia_id])
  @@index([agenciaId, created_at])
  @@map("avisos_enviados")
}

// Seguimiento de un recibo PAGADO con diferencia de comisión: reclamos, notas y cierre.
/**
 * Renglón de un estado de cuenta que la conciliación no pudo aplicar: la póliza no está en el
 * CRM (no_encontrado) o hay que revisarlo a mano (revisar). Explica en Pólizas → Sin conciliar
 * por qué una póliza no se concilió. Los de un lote revertido se ignoran.
 */
model LoteRenglon {
  id              String  @id @default(cuid())
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId       String  @map("agencia_id") @db.Uuid
  agencia         Agencia @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  lote_id         String
  fila            Int
  // Número de póliza tal como venía en el archivo.
  poliza_archivo  String
  // "no_encontrado" | "revisar"
  estatus         String
  detalle         String?
  comision_pagada Decimal @db.Decimal(14, 2)
  folio           String?
  // Póliza del CRM con la que se cruzó (solo en "revisar"); null si no se encontró.
  poliza_id       String?

  lote   LoteConciliacion @relation(fields: [lote_id], references: [id], onDelete: Cascade)
  poliza Poliza?          @relation(fields: [poliza_id], references: [id], onDelete: SetNull)

  @@index([lote_id])
  @@index([poliza_id])
  @@index([agenciaId])
  @@map("lotes_renglones")
}

model NotaAclaracion {
  id            String   @id @default(cuid())
  // Agencia dueña del registro: toda consulta y escritura debe llevarla explícitamente.
  agenciaId     String   @map("agencia_id") @db.Uuid
  agencia       Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Restrict)
  created_at    DateTime @default(now())
  recibo_id     String
  usuario_email String?
  // "reclamo" | "nota" | "pago_adicional" | "aceptada"
  tipo          String
  texto         String
  // Solo en "pago_adicional": comisión adicional recibida.
  monto         Decimal? @db.Decimal(14, 2)

  recibo Recibo @relation(fields: [recibo_id], references: [id], onDelete: Cascade)

  @@index([recibo_id, created_at])
  @@index([agenciaId])
  @@map("notas_aclaracion")
}
